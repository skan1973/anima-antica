NODE_ENV=development
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Use a random secret with at least 32 chars. Do not use placeholders in production.
JWT_SECRET=<set-a-long-random-secret-here-min-32-chars>
# Optional: socket auth token lifetime in seconds.
SOCKET_TOKEN_TTL_SECONDS=3600
# Optional: external monitoring webhook for structured error events.
ERROR_MONITOR_WEBHOOK_URL=
# Optional: timeout for external monitor delivery.
ERROR_MONITOR_TIMEOUT_MS=3000
# Optional: include stack traces in logs (keep false in production unless strictly needed).
LOG_INCLUDE_STACK=false
# In production PORT must be set explicitly.
PORT=3000
# Comma-separated explicit origins only. Wildcard (*) is rejected.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Optional: limit simultaneous PeerJS clients to reduce abuse/resource exhaustion.
PEER_CONCURRENT_LIMIT=1000
# Optional: HTTP rate limiting for /peerjs endpoint family.
PEER_RATE_LIMIT_WINDOW_MS=60000
PEER_RATE_LIMIT_MAX_REQ=180
# Optional: max simultaneous active Peer sockets per source IP.
PEER_MAX_CONNECTIONS_PER_IP=20
