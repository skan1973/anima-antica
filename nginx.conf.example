# Configurazione di sicurezza Nginx per ANIMA ANTICA
# Da inserire in /etc/nginx/sites-available/anima-antica

server {
    listen 80;
    server_name il-tuo-dominio.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name il-tuo-dominio.com;

    # SSL - Utilizza certificati Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/il-tuo-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/il-tuo-dominio.com/privkey.pem;

    # Sicurezza SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        
        # Proxying per Socket.io e WebSocket
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Header di sicurezza
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
