{
  "name": "anima-antica",
  "version": "1.0.0",
  "description": "Progetto ANIMA ANTICA",
  "main": "server.js",
  "scripts": {
    "start": "node server/server.js",
    "test:unit": "node --test tests/*.test.js",
    "test:all": "npm run test:unit && npm run test:call",
    "test:call": "node test-chiamata.js",
    "test:e2e": "node scripts/test-e2e.js",
